# Copia este archivo a .env (nunca subas .env al repositorio) para probar
# la actualización del catálogo en local con `npm run fetch-catalog`.
#
# Credenciales de Amazon Creators API (sucesora de PA-API 5.0 desde el
# 15/05/2026). Se generan en Amazon Associates Central > Herramientas >
# Creators API > Crear aplicación > Agregar nueva credencial.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=lasmejores03-21

# Opcionales: solo si cambias de mercado (por defecto España / región Europa)
# AMAZON_TOKEN_ENDPOINT=https://api.amazon.co.uk/auth/o2/token
# AMAZON_MARKETPLACE=www.amazon.es
