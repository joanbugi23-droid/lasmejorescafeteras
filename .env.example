# Copia este archivo a .env (nunca subas .env al repositorio) para probar
# la actualización de precios en local con `npm run fetch-prices`.
#
# Credenciales de Amazon Product Advertising API 5.0 (España/Asociados)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=lasmejores03-21

# Opcionales: solo si cambias de mercado (por defecto España)
# AMAZON_HOST=webservices.amazon.es
# AMAZON_REGION=eu-west-1
# AMAZON_MARKETPLACE=www.amazon.es
