---
interface Props {
  asin: string;
  data?: {
    title?: string | null;
    image?: string | null;
    price?: string | null;
    previousPrice?: string | null;
    discountPercent?: number | null;
    available?: boolean;
    availabilityMessage?: string | null;
    starRating?: number | null;
    reviewCount?: number | null;
    url?: string | null;
    provisional?: boolean;
  } | null;
  partnerTag: string;
  featured?: boolean;
  badgeLabel?: string | string[] | null;
  gauge?: { position: number; tier: string } | null;
}

const { asin, data, partnerTag, featured = false, badgeLabel = null, gauge = null } = Astro.props;
const badges = badgeLabel ? (Array.isArray(badgeLabel) ? badgeLabel : [badgeLabel]) : featured ? ["Recomendada"] : [];

const title = data?.title ?? "Cafetera disponible en Amazon";
const image = data?.image ?? null;
const url = data?.url ?? `https://www.amazon.es/dp/${asin}?tag=${partnerTag}`;
const available = data?.available ?? true;
const price = data?.price ?? null;
const previousPrice = available ? data?.previousPrice ?? null : null;
const discountPercent = available ? data?.discountPercent ?? null : null;
const starRating = data?.starRating ?? null;
const reviewCount = data?.reviewCount ?? null;
const fullStars = starRating ? Math.round(starRating) : 0;
---

<article class:list={["product-card", { "is-unavailable": !available }]}>
  {
    (badges.length > 0 || discountPercent) && available && (
      <div class="badges-row">
        {badges.map((label) => (
          <span class="badge gold">{label}</span>
        ))}
        {discountPercent && <span class="badge deal">-{discountPercent}%</span>}
      </div>
    )
  }
  <a class="thumb" href={url} target="_blank" rel="nofollow sponsored noopener" aria-hidden="true" tabindex="-1">
    {image ? <img src={image} alt={title} loading="lazy" /> : <div class="thumb-empty" aria-hidden="true" />}
  </a>
  <div class="body">
    <h3>
      <a href={url} target="_blank" rel="nofollow sponsored noopener">
        {title}
      </a>
    </h3>
    {
      available && (
        <a class="cta cta-top" href={url} target="_blank" rel="nofollow sponsored noopener">
          Ver en Amazon
        </a>
      )
    }
    {
      starRating && (
        <div class="rating" aria-label={`${starRating} de 5 estrellas`}>
          <span class="rating-number">{starRating}</span>
          <span class="stars" aria-hidden="true">
            {"★".repeat(fullStars)}
            {"☆".repeat(5 - fullStars)}
          </span>
          {reviewCount && <span class="review-count">({reviewCount} opiniones)</span>}
        </div>
      )
    }
    {
      !available ? (
        <div class="price unavailable">No disponible actualmente</div>
      ) : price ? (
        <div class="price-row">
          <span class="price">{price}</span>
          {previousPrice && (
            <span class="price-before-wrap">
              <span class="price-before-label">Antes</span>
              <span class="price-before">{previousPrice}</span>
            </span>
          )}
          {data?.provisional && <span class="provisional-note">precio provisional</span>}
        </div>
      ) : (
        <div class="price unavailable">Ver precio actual en Amazon</div>
      )
    }
    {
      available && gauge && (
        <div class="price-gauge">
          <div class="gauge-label">
            <span>Económica</span>
            <span class="current">{gauge.tier}</span>
            <span>Premium</span>
          </div>
          <div class="gauge-track">
            <span class="marker" style={`left: ${gauge.position}%;`} />
          </div>
        </div>
      )
    }
    {
      available && data?.availabilityMessage && (
        <div class="availability">
          <span class="availability-icon" aria-hidden="true">
            ✓
          </span>
          {data.availabilityMessage}
        </div>
      )
    }
    <a class="cta cta-bottom" href={url} target="_blank" rel="nofollow sponsored noopener">
      Ver en Amazon
    </a>
  </div>
</article>
