---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import LifestyleIllustration from "../../components/LifestyleIllustration.astro";
import categories from "../../data/categories.json";
import comparisons from "../../data/comparisons.json";
import { loadCatalog, resolveItems, lastUpdatedLabel, categoryHighlights, priceGauge, minPriceLabel } from "../../lib/catalog.mjs";
import { breadcrumbJsonLd, itemListJsonLd, faqJsonLd } from "../../lib/seo.mjs";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const PARTNER_TAG = import.meta.env.PUBLIC_PARTNER_TAG || "lasmejores03-21";
const catalog = loadCatalog();
const categoryItems = resolveItems(catalog.categories[category.slug], catalog.items);
const updatedLabel = lastUpdatedLabel(catalog.items);
const highlights = categoryHighlights(categoryItems);
const faqs = category.faqs ?? [];
const relatedPosts = (await getCollection("blog")).filter(
  (post) => post.data.relatedCategory === category.slug
);
const relatedComparisons = comparisons.filter((cmp) => cmp.relatedCategory === category.slug);
const fromPrice = minPriceLabel(categoryItems);

const breadcrumbs = breadcrumbJsonLd([
  { name: "Inicio", path: "/" },
  { name: category.shortTitle, path: `/${category.slug}/` },
]);
const itemList = categoryItems.length > 0 ? itemListJsonLd(categoryItems, category.title) : null;
const faqSchema = faqs.length > 0 ? faqJsonLd(faqs) : null;

const pageTitle = fromPrice
  ? `${category.title} desde ${fromPrice}: Comparativa y Precios Actualizados`
  : `${category.title}: Comparativa y Precios Actualizados`;
const pageDescription = fromPrice ? `${category.intro} Precios desde ${fromPrice}.` : category.intro;
---

<Base title={pageTitle} description={pageDescription} image={categoryItems[0]?.image}>
  <JsonLd data={breadcrumbs} />
  {itemList && <JsonLd data={itemList} />}
  {faqSchema && <JsonLd data={faqSchema} />}

  <div class="container">
    <nav class="breadcrumbs">
      <a href="/">Inicio</a> / {category.shortTitle}
    </nav>

    <header class="page-hero">
      <h1>{category.title}</h1>
      {updatedLabel && <span class="updated-pill">Precios actualizados {updatedLabel}</span>}
    </header>

    <section class="section" style="padding-top: 6px;">
      <div class="product-grid">
        {
          categoryItems.map((item) => (
            <ProductCard
              asin={item.asin}
              data={item}
              partnerTag={PARTNER_TAG}
              badgeLabel={highlights[item.asin]}
              gauge={priceGauge(item, categoryItems)}
            />
          ))
        }
      </div>
    </section>

    <section class="section guide-section">
      <div class="guide-intro">
        <div>
          <h2 class="section-title">Guía de Compra: {category.shortTitle}</h2>
          <p class="section-lead">{category.intro}</p>
        </div>
        <LifestyleIllustration />
      </div>

      <div class="pros-cons">
        <div class="pros">
          <h3>✔ Ventajas</h3>
          <ul>
            {category.pros.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="cons">
          <h3>✘ Desventajas</h3>
          <ul>
            {category.cons.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      {
        faqs.length > 0 && (
          <div class="faq-list">
            {faqs.map((faq) => (
              <details class="faq-item">
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        )
      }

      {
        (relatedPosts.length > 0 || relatedComparisons.length > 0) && (
          <ul class="guide-links" style="margin-top: 20px;">
            {relatedPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </li>
            ))}
            {relatedComparisons.map((cmp) => (
              <li>
                <a href={`/vs/${cmp.slug}/`}>{cmp.title}</a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Base>
