---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import tops from "../../data/tops.json";
import { loadCatalog, resolveItems, lastUpdatedLabel } from "../../lib/catalog.mjs";
import { breadcrumbJsonLd, itemListJsonLd } from "../../lib/seo.mjs";

export function getStaticPaths() {
  return tops.map((top) => ({
    params: { year: String(top.year) },
    props: { top },
  }));
}

const { top } = Astro.props;
const PARTNER_TAG = import.meta.env.PUBLIC_PARTNER_TAG || "lasmejores03-21";
const catalog = loadCatalog();
const items = resolveItems(top.asins, catalog.items);
const updatedLabel = lastUpdatedLabel(catalog.items);

const breadcrumbs = breadcrumbJsonLd([
  { name: "Inicio", path: "/" },
  { name: `Top Cafeteras ${top.year}`, path: `/top-cafeteras-${top.year}/` },
]);
const itemList = items.length > 0 ? itemListJsonLd(items, `Top Cafeteras ${top.year}`) : null;
---

<Base
  title={`Top Cafeteras ${top.year}: Las Más Recomendadas`}
  description={`Selección de las mejores cafeteras de ${top.year}, con precios y disponibilidad de Amazon actualizados automáticamente.`}
  image={items[0]?.image}
>
  <JsonLd data={breadcrumbs} />
  {itemList && <JsonLd data={itemList} />}

  <div class="container">
    <nav class="breadcrumbs">
      <a href="/">Inicio</a> / Top Cafeteras {top.year}
    </nav>

    <header class="page-hero">
      <h1>Top Cafeteras {top.year}</h1>
      {updatedLabel && <span class="updated-pill">Precios actualizados {updatedLabel}</span>}
    </header>

    <section class="section" style="padding-top: 6px;">
      <div class="product-grid">
        {
          items.map((item) => (
            <ProductCard asin={item.asin} data={item} partnerTag={PARTNER_TAG} featured />
          ))
        }
      </div>
    </section>
  </div>
</Base>
