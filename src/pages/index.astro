---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import categories from "../data/categories.json";
import products from "../data/products.json";
import { loadPrices } from "../lib/prices.mjs";

const PARTNER_TAG = import.meta.env.PUBLIC_PARTNER_TAG || "lafamilialoca-21";
const prices = loadPrices();

const featured = products
  .filter((p) => p.featured)
  .slice(0, 5);

const categoryIcons = {
  "las-mejores-cafeteras-italianas": "🫖",
  "las-mejores-cafeteras-express": "☕",
  "las-mejores-cafeteras-superautomaticas": "⚙️",
  "las-mejores-cafeteras-de-grano": "🌱",
  "las-mejores-cafeteras-de-capsulas": "💊",
};
---

<Base
  title="Las Mejores Cafeteras 2025 | Guía de compra y precios actualizados"
  description="Comparativas y recomendaciones de las mejores cafeteras italianas, express, superautomáticas, de grano y de cápsulas, con precios de Amazon actualizados a diario."
>
  <section class="hero">
    <div class="container">
      <h1>Encuentra la Cafetera Perfecta para Ti</h1>
      <p>
        Analizamos cafeteras italianas, express, superautomáticas, de grano y de cápsulas
        para ayudarte a elegir con confianza. Los precios se actualizan automáticamente
        cada día directamente desde Amazon.
      </p>
      <p class="disclosure">Como Afiliados de Amazon, obtenemos ingresos por las compras que cumplen los requisitos aplicables.</p>
    </div>
  </section>

  <div class="container">
    <div class="category-grid">
      {
        categories.map((cat) => (
          <a class="category-card" href={`/${cat.slug}/`}>
            <span class="icon">{categoryIcons[cat.slug]}</span>
            <h3>{cat.shortTitle}</h3>
            <p>{cat.intro.slice(0, 90)}…</p>
          </a>
        ))
      }
    </div>

    {
      featured.length > 0 && (
        <section class="section">
          <h2 class="section-title">Las Cafeteras que Más Recomendamos</h2>
          <p class="section-lead">
            Una selección de nuestras favoritas entre todas las categorías, por calidad, prestaciones y opiniones.
          </p>
          <div class="product-grid">
            {featured.map((p) => (
              <ProductCard asin={p.asin} data={prices[p.asin]} partnerTag={PARTNER_TAG} featured />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
