---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import JsonLd from "../components/JsonLd.astro";
import categories from "../data/categories.json";
import tops from "../data/tops.json";
import {
  loadCatalog,
  resolveItems,
  activeDeals,
  lastUpdatedLabel,
  priceGauge,
  rankBadges,
} from "../lib/catalog.mjs";
import { itemListJsonLd } from "../lib/seo.mjs";

const PARTNER_TAG = import.meta.env.PUBLIC_PARTNER_TAG || "lasmejores03-21";
const catalog = loadCatalog();
const updatedLabel = lastUpdatedLabel(catalog.items);

const top = resolveItems(catalog.top, catalog.items);
const top3 = top.slice(0, 3);
const top6 = top.slice(3, 9);
const badges3 = rankBadges(top3);
const deals = activeDeals(catalog);
const currentYear = new Date().getFullYear();
const currentTop = tops.find((t) => t.year === currentYear) ?? tops[tops.length - 1];

const categoryPreviews = categories.map((cat) => ({
  category: cat,
  items: resolveItems(catalog.categories[cat.slug], catalog.items).slice(0, 3),
}));

const topItemList = top.length > 0 ? itemListJsonLd(top, "Top Cafeteras") : null;
const dealsItemList = deals.length > 0 ? itemListJsonLd(deals, "Ofertas del Mes") : null;
---

<Base
  title="Las Mejores Cafeteras | Comparativas, Precios y Ofertas Reales"
  description="Cuál es la mejor cafetera del mercado: comparativas de cafeteras italianas, express, superautomáticas, de grano, cápsulas y goteo, con precio, valoración y disponibilidad de Amazon actualizados a diario."
  image={top[0]?.image}
>
  {topItemList && <JsonLd data={topItemList} />}
  {dealsItemList && <JsonLd data={dealsItemList} />}

  <div class="container">
    <header class="page-hero">
      <div>
        <p class="eyebrow">Actualizado {updatedLabel ?? "automáticamente"} · datos reales de Amazon</p>
        <h1>Las 3 Mejores Cafeteras Ahora Mismo</h1>
      </div>
    </header>

    {
      top3.length > 0 && (
        <section class="section" style="padding-top: 10px;" aria-labelledby="top3-heading">
          <h2 class="section-title" id="top3-heading" style="position:absolute; left:-9999px;">
            Las 3 mejores cafeteras
          </h2>
          <div class="product-grid">
            {top3.map((item) => (
              <ProductCard
                asin={item.asin}
                data={item}
                partnerTag={PARTNER_TAG}
                badgeLabel={badges3[item.asin]}
                gauge={priceGauge(item, top)}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      top6.length > 0 && (
        <section class="section" aria-labelledby="top6-heading">
          <div class="section-head">
            <h2 class="section-title" id="top6-heading">
              Más Recomendadas
            </h2>
          </div>
          <div class="product-grid">
            {top6.map((item) => (
              <ProductCard asin={item.asin} data={item} partnerTag={PARTNER_TAG} gauge={priceGauge(item, top)} />
            ))}
          </div>
        </section>
      )
    }

    {
      deals.length > 0 && (
        <section class="section" aria-labelledby="deals-heading">
          <div class="section-head">
            <h2 class="section-title" id="deals-heading">
              Ofertas del Mes
            </h2>
          </div>
          <div class="product-grid">
            {deals.map((item) => (
              <ProductCard asin={item.asin} data={item} partnerTag={PARTNER_TAG} gauge={priceGauge(item, deals)} />
            ))}
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="categories-heading">
      <div class="section-head">
        <h2 class="section-title" id="categories-heading">
          Lo Mejor de Cada Categoría
        </h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: 18px;">
        {
          categoryPreviews.map(({ category, items }) => (
            <div class="cat-strip">
              <div class="cat-strip-head">
                <h3>{category.shortTitle}</h3>
                <a class="see-all" href={`/${category.slug}/`}>
                  Ver todas →
                </a>
              </div>
              {items.length > 0 ? (
                <div class="product-grid">
                  {items.map((item) => (
                    <ProductCard asin={item.asin} data={item} partnerTag={PARTNER_TAG} gauge={priceGauge(item, items)} />
                  ))}
                </div>
              ) : (
                <p class="section-lead" style="margin:0;">
                  Cargando selección — disponible en cuanto se actualice el catálogo.
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="section guide-section">
      <h2 class="section-title">Cómo Elegir tu Cafetera</h2>
      <p class="section-lead">
        Si eres un amante del café, sabes que elegir la cafetera adecuada marca la diferencia. Analizamos
        cafeteras italianas, express, superautomáticas, de grano y de cápsulas para ayudarte a decidir según
        cómo te gusta el café, cuánto espacio tienes y cuánto quieres implicarte en la preparación.
      </p>
      <p class="section-lead">
        Explora cada categoría para ver ventajas, desventajas y los modelos disponibles ahora mismo en Amazon,
        con precio y disponibilidad reales:
      </p>
      <ul class="guide-links">
        {
          categories.map((cat) => (
            <li>
              <a href={`/${cat.slug}/`}>{cat.title}</a>
            </li>
          ))
        }
        {currentTop && (
          <li>
            <a href={`/top-cafeteras-${currentTop.year}/`}>Top Cafeteras {currentTop.year}</a>
          </li>
        )}
        <li>
          <a href="/blog/">Guías y Comparativas (Blog)</a>
        </li>
      </ul>
    </section>
  </div>
</Base>
